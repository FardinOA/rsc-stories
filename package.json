{
  "name": "rsc-stories",
  "version": "0.1.0",
  "description": "A component workshop for React Server Components: async server stories, real RSC rendering through your own Next.js, server-side mocks, and an RSC Boundary Inspector.",
  "license": "MIT",
  "author": "Fardin",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "rsc-stories": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime/server": {
      "types": "./dist/runtime/server.d.ts",
      "default": "./dist/runtime/server.js"
    },
    "./runtime/client": {
      "types": "./dist/runtime/client.d.ts",
      "default": "./dist/runtime/client.js"
    },
    "./runtime/mock": {
      "types": "./dist/runtime/mock.d.ts",
      "default": "./dist/runtime/mock.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "react-server": "./dist/test.server.js",
      "default": "./dist/test.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./vitest/plugin": {
      "types": "./dist/vitest/plugin.d.ts",
      "default": "./dist/vitest/plugin.js"
    },
    "./vitest/global-setup": {
      "types": "./dist/vitest/global-setup.d.ts",
      "default": "./dist/vitest/global-setup.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./next-config": {
      "types": "./dist/next-config.d.ts",
      "default": "./dist/next-config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "nextjs",
    "app-router",
    "storybook",
    "stories",
    "component-workshop",
    "mocking",
    "server-actions"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsup && node scripts/build-ui.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:conformance": "node conformance/run.mjs",
    "size": "size-limit",
    "docs:build": "node docs/build.mjs",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.10",
    "jiti": "^2.6.1",
    "linkedom": "^0.18.12",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.15"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "next": ">=15.0.0",
    "playwright": ">=1.40.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "typescript": ">=5.0.0",
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/expect": "^3.2.7",
    "@vitest/spy": "^3.2.7",
    "chai": "^5.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "marked": "^16.4.0",
    "next": "16.4.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "size-limit": [
    {
      "name": "workshop UI (JS)",
      "path": "dist/ui/assets/*.js",
      "limit": "150 kB",
      "gzip": true
    }
  ],
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
